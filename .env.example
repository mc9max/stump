# Stump — comics, manga and digital book server on Railway
# (wrapper variables; the server itself reads STUMP_* at runtime)

# Railway injects this automatically; entrypoint.sh maps it to STUMP_PORT.
# Do not set it yourself on a template deploy.
PORT=

# Baked into the wrapper image; override only if you know why.
# STUMP_CONFIG_DIR=/data/config
# STUMP_TRUST_PROXY_HEADERS=true

# Optional upstream settings (all read from the STUMP_ env prefix).
# Uncomment and set as service variables to change them.
# STUMP_VERBOSITY=1
# STUMP_ENABLE_UPLOAD=false
# STUMP_ENABLE_KOREADER_SYNC=false
# STUMP_ENABLE_KOBO_SYNC=false
# STUMP_ENABLE_OPDS_PROGRESSION=false
# STUMP_ENABLE_PLAYGROUND=false
# STUMP_SESSION_TTL=86400
# STUMP_PASSWORD_HASH_COST=12
# STUMP_PARALLELISM_MULTIPLIER=2
# STUMP_PDF_RENDER_DPI=150
# STUMP_PDF_MAX_DIMENSION=1200
# STUMP_PDF_RENDER_FORMAT=webp
# STUMP_ALLOWED_ORIGINS=
